{
  "name": "@pi-durable-extensions/context7",
  "version": "0.1.0-candidate.1",
  "description": "Portable Context7 MCP extension for Pi Durable",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/context7-mcp.ts",
      "import": "./src/context7-mcp.ts"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "check": "tsc --noEmit --skipLibCheck --allowImportingTsExtensions --module nodenext --moduleResolution nodenext --target es2023 --strict --erasableSyntaxOnly --resolveJsonModule src/context7-mcp.ts",
    "test": "node --test test/*.test.mjs",
    "example": "node examples/bare-durable.mjs",
    "example:live": "node examples/live-bare-durable.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0"
  }
}
